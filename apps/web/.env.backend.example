# ============================================================
# Nara Charm 后端 .env 模板 (Contabo 部署用)
# 复制为 .env 并填入真实值。Docker --env-file 会保留引号。
# ============================================================

# ── 数据库 (Contabo 自建 Postgres) ─────────────────────────
# 如果 PostgreSQL 在同一个 Docker 网络，用数据库容器的服务名。
DATABASE_URL=postgresql://user:password@postgres:5432/naracharm

# ── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── 邮件 (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@naracharm.com
SUPPORT_EMAIL=support@naracharm.com

# ── Better Auth ────────────────────────────────────────────
# 32+ 位随机串: openssl rand -base64 32
BETTER_AUTH_SECRET=生成32+位随机字符串
BETTER_AUTH_URL=https://api.naracharm.com

# ── 前端域名 (跨域信任) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.naracharm.com
NEXT_PUBLIC_SITE_URL=https://naracharm.com

# 跨域 cookie (子域共享登录) — 需在 auth.ts 中启用
COOKIE_DOMAIN=.naracharm.com

# ── 运行环境 ───────────────────────────────────────────────
NODE_ENV=production
PORT=37001
